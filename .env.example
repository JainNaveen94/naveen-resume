# Formspree form ID. If unset, contact uses mailto fallback.
# Dummy value for local testing - replace with your real ID from formspree.io
VITE_FORMSPREE_ID=xdummyid

# Canonical site URL for Open Graph / JSON-LD (replace with your real domain)
VITE_SITE_URL=https://naveenjain.example

# Force mailto even when Formspree is configured (optional)
# VITE_FORCE_MAILTO=false
